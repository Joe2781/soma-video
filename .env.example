# Environment
NODE_ENV=development

# Database
DATABASE_URL=postgresql://soma:soma_dev@localhost:5432/soma_video_dev

# API Keys
GEMINI_API_KEY=your-gemini-api-key
VEO_API_KEY=your-veo-api-key

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRY=7d

# API Server
API_PORT=3001
API_HOST=localhost
API_LOG_LEVEL=debug

# Redis (for Bull queue)
REDIS_URL=redis://localhost:6379

# Features
FEATURE_STORY_GENERATION=true
FEATURE_SCREENPLAY_GENERATION=true
FEATURE_SHOT_PLANNING=true
FEATURE_VEO_GENERATION=true
