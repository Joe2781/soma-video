{
  "name": "soma-video",
  "version": "0.1.0",
  "description": "AI film-production application",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run --workspaces dev",
    "build": "npm run --workspaces build",
    "test": "npm run --workspaces test",
    "lint": "npm run --workspaces lint",
    "format": "npm run --workspaces format",
    "type-check": "npm run --workspaces type-check",
    "db:migrate": "cd packages/db && npm run migrate",
    "db:rollback": "cd packages/db && npm run rollback",
    "db:seed": "cd packages/db && npm run seed"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
