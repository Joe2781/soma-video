{
  "name": "soma-video",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run --workspace apps/api dev",
    "build": "npm run --workspaces build",
    "type-check": "npm run --workspaces type-check",
    "lint": "npm run --workspaces lint",
    "db:generate": "npm run --workspace packages/db prisma:generate",
    "db:migrate": "npm run --workspace packages/db prisma:migrate",
    "db:studio": "npm run --workspace packages/db prisma:studio"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
