// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Production {
  id        String   @id @default(cuid())
  title     String
  idea      String
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  storyPlan      StoryPlan?
  screenplayPlan ScreenplayPlan?
  scenePlans     ScenePlan[]
  shotPlans      ShotPlan[]
}

model StoryPlan {
  id           String   @id @default(cuid())
  productionId String   @unique
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)

  title     String
  logline   String
  genre     String
  tone      String
  premise   String
  acts      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scenePlans ScenePlan[]
  shotPlans  ShotPlan[]
}

model ScreenplayPlan {
  id        String   @id @default(cuid())
  productionId String  @unique
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  storyPlanId String
  storyPlan   StoryPlan? @relation(fields: [storyPlanId], references: [id], onDelete: SetNull)

  title String
  logline String
  continuityWarnings Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scenes ScreenplayScene[]
}

model ScreenplayScene {
  id                String   @id @default(cuid())
  productionId      String
  production        Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  screenplayPlanId  String
  screenplayPlan    ScreenplayPlan @relation(fields: [screenplayPlanId], references: [id], onDelete: Cascade)

  sceneNumber       Int
  heading           String
  location          String
  timeOfDay         String
  visualBeat        String
  action            String
  dialogue          String
  continuityNotes   Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([screenplayPlanId, sceneNumber])
}

model ScenePlan {
  id             String   @id @default(cuid())
  productionId   String
  production     Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  storyPlanId    String
  storyPlan      StoryPlan @relation(fields: [storyPlanId], references: [id], onDelete: Cascade)

  sceneNumber    Int
  title          String
  setting        String
  objective      String
  conflict       String
  cinematicNotes String
  transition     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shots ShotPlan[]

  @@unique([storyPlanId, sceneNumber])
}

model ShotPlan {
  id             String   @id @default(cuid())
  productionId   String
  production     Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  storyPlanId    String
  storyPlan      StoryPlan @relation(fields: [storyPlanId], references: [id], onDelete: Cascade)
  scenePlanId    String
  scenePlan      ScenePlan @relation(fields: [scenePlanId], references: [id], onDelete: Cascade)

  sceneNumber    Int
  shotNumber     Int
  description    String
  camera         String
  lens           String
  movement       String
  composition    String
  durationSeconds Int
  visualNotes    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([scenePlanId, shotNumber])
}
